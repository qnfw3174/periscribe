# --- Periscribe ---

# Local secrets / config (never commit write keys)
collector/config.json
web/config.js
.env
.env.*

# Offset checkpoints
*.offset.json
checkpoints/

# Collector logs
logs/
*.log

# Scratch / temp (verification scripts, commit messages)
_*.py
_commitmsg.txt
*.tmp.png

# PyInstaller build artifacts
packaging/dist/
packaging/build/
packaging/*.spec

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node (web tooling, if any) ---
node_modules/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
